{
    "version": 2,
    "regions": ["hkg1"],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/fund-api/(.*)",
            "dest": "/fund-api/$1"
        },
        {
            "src": "/.*",
            "dest": "/"
        }
    ],
    "installCommand": "pnpm install",
    "buildCommand": "pnpm build",
    "crons": [
        {
            "path": "/fund-api/cron",
            "schedule": "30 6 * * *"
        },
        {
            "path": "/fund-api/cron/index",
            "schedule": "40 6 * * *"
        }
    ]
}
